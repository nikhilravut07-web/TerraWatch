# Optional: persistent SQLite location (default: data/terrawatch.sqlite3)
# TERRAWATCH_DB_PATH=./data/terrawatch.sqlite3
# TERRAWATCH_DATA_DIR=./data
# No API keys are required for deterministic demo mode.

# Comma-separated frontend origins allowed to call FastAPI (set your Vercel URL on deployment)
# TERRAWATCH_CORS_ORIGINS=http://localhost:5173,https://your-terrawatch.vercel.app
